cation\": {\n        \"page\": 1,\n        \"section\": \"Green banner callout box\",\n        \"bbox\": [0.16, 0.47, 0.41, 0.51],\n        \"quote\": \"Emergency Healthcare +000 12345 6489\"\n      },\n      \"notes\": \"Emergency contact callout displaying a placeholder phone number.\"\n    },\n    {\n      \"item_id\": \"C5\",\n      \"kind\": \"visual_element\",\n      \"text\": \"Color photograph of a male physician wearing a white coat, collared shirt, tie, and stethoscope, holding a smartphone and smiling.\",\n      \"location\": {\n        \"page\": 1,\n        \"section\": \"Upper right hero image\",\n        \"bbox\": [0.52, 0.18, 0.86, 0.54],\n        \"quote\": null\n      },\n      \"notes\": \"Stock visual depicting an HCP/physician.\"\n    },\n    {\n      \"item_id\": \"C6\",\n      \"kind\": \"product_claim\",\n      \"text\": \"Free Health Screening / For senior citizen & children for under 12 / www.healthcarecenter.com/register\",\n      \"location\": {\n        \"page\": 1,\n        \"section\": \"Services list - Item 1\",\n        \"bbox\": [0.16, 0.56, 0.46, 0.61],\n        \"quote\": \"Free Health Screening For senior citizen & children for under 12\"\n      },\n      \"notes\": \"Promotional service offering with demographic eligibility parameters (senior citizens and children under 12) and registration URL.\"\n    },\n    {\n      \"item_id\": \"C7\",\n      \"kind\": \"product_claim\",\n      \"text\": \"Emergency / Get an Expert Medical Opinion from one of our world-renowned specialists so you can have the answers and\",\n      \"location\": {\n        \"page\": 1,\n        \"section\": \"Services list - Item 2\",\n        \"bbox\": [0.16, 0.63, 0.50, 0.68],\n        \"quote\": \"Emergency Get an Expert Medical Opinion from one of our world-renowned specialists\"\n      },\n      \"notes\": \"Description text is truncated and duplicates C3.\"\n    },\n    {\n      \"item_id\": \"C8\",\n      \"kind\": \"product_claim\",\n      \"text\": \"
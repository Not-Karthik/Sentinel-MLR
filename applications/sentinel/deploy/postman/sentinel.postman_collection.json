{
  "info": {
    "name": "Sentinel backend",
    "description": "A2A multi-agent endpoint and FastAPI routes. Select the Sentinel environment and set base_url. Set Postman Settings > Request timeout to 0 because agent runs take minutes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.variables.get('token');",
          "if (token && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "docs"
              ]
            },
            "description": "Open this URL in a browser for interactive API docs with request and response schemas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/openapi.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });"
                ]
              }
            }
          ]
        },
        {
          "name": "A2A agent card",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/a2a/app/.well-known/agent-card.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "a2a",
                "app",
                ".well-known",
                "agent-card.json"
              ]
            },
            "description": "url must equal the public service URL + /a2a/app."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });",
                  "const card = pm.response.json();",
                  "pm.test('card has a name', function () { pm.expect(card.name).to.be.a('string'); });",
                  "console.log('Agent card url:', card.url);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Media (image input)",
      "item": [
        {
          "name": "Upload image or PDF",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/media",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "media"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "Pick a PNG, JPEG, WebP, GIF or PDF (max 32 MB) in the file field. The test saves media_uri and media_mime for the A2A requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });",
                  "const body = pm.response.json();",
                  "pm.test('returns a gs:// uri', function () { pm.expect(body.uri).to.match(/^gs:\\/\\//); });",
                  "pm.environment.set('media_uri', body.uri);",
                  "pm.environment.set('media_mime', body.mime_type);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. A2A (v0.3 shape, default)",
      "item": [
        {
          "name": "message/send - text (blocking)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/a2a/app",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "a2a",
                "app"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"{{$guid}}\",\n  \"method\": \"message/send\",\n  \"params\": {\n    \"message\": {\n      \"kind\": \"message\",\n      \"messageId\": \"{{$guid}}\",\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"kind\": \"text\",\n          \"text\": \"Review this promotional claim for MLR compliance: 'OncoBoost delivers unmatched 95% survival with zero serious adverse events.' Provide a full risk breakdown.\"\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Blocks until the whole multi-agent run finishes (minutes). Set Postman Settings > Request timeout to 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });",
                  "pm.test('no JSON-RPC error', function () { pm.expect(pm.response.json().error).to.be.undefined; });",
                  "const body = pm.response.json();",
                  "const result = body.result || {};",
                  "const task = result.task || result;",
                  "const ctx = task.contextId || result.contextId;",
                  "const id = task.id || result.taskId;",
                  "if (ctx) pm.environment.set('context_id', ctx);",
                  "if (id) pm.environment.set('task_id', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "message/send - image by uploaded URI (blocking)",
          "request": {
            "method": "POST",
            "header": [

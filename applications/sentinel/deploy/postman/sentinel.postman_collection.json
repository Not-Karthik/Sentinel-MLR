                  "const result = body.result || {};",
                  "const task = result.task || result;",
                  "const ctx = task.contextId || result.contextId;",
                  "const id = task.id || result.taskId;",
                  "if (ctx) pm.environment.set('context_id', ctx);",
                  "if (id) pm.environment.set('task_id', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "SendStreamingMessage - image by uploaded URI (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "A2A-Version",
                "value": "1.0"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/a2a/app",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "a2a",
                "app"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"{{$guid}}\",\n  \"method\": \"SendStreamingMessage\",\n  \"params\": {\n    \"message\": {\n      \"messageId\": \"{{$guid}}\",\n      \"role\": \"ROLE_USER\",\n      \"parts\": [\n        {\n          \"text\": \"Review the attached promotional image for MLR compliance and return findings with bounding boxes.\"\n        },\n        {\n          \"url\": \"{{media_uri}}\",\n          \"mediaType\": \"{{media_mime}}\"\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', function () { pm.response.to.be.success; });",
                  "const text = pm.response.text();",
                  "let ctx = null, id = null, errorMessage = null;",
                  "text.split(/\\r?\\n/).forEach(function (line) {",
                  "  if (!line.startsWith('data:')) return;",
                  "  try {",
                  "    const event = JSON.parse(line.slice(5).trim());",
                  "    if (event.error) errorMessage = event.error.message;",
                  "    const result = event.result || {};",
                  "    const node = result.task || result.statusUpdate || result.artifactUpdate || result.message || result;",
                  "    ctx = node.contextId || result.contextId || ctx;",
                  "    id = node.taskId || node.id || result.taskId || id;",
                  "  } catch (e) {}",
                  "});",
                  "pm.test('stream has no JSON-RPC error', function () { pm.expect(errorMessage).to.eql(null); });",
                  "pm.test('stream returned events', function () { pm.expect(text).to.include('data:'); });",
                  "if (ctx) pm.environment.set('context_id', ctx);",
                  "if (id) pm.environment.set('task_id', id);"
                ]
              }
            }
          ]
        },
